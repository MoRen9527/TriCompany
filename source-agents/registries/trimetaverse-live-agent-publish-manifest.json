  "date": "2026-05-24",
  "sourceRoot": "TriCompany/source-agents for role, central strategy and governance agents; module-local .github/agents for migrated module registry agents; module-local role live entries may target their owning module .github/agents",
  "liveRoot": "multi-root .github/agents; TriMetaverse/.github/agents remains the current live surface for employee role agents and central agents after each module registry migration; TriCompany/.github/agents is valid only for TriCompany module registry agents and code/document maintenance agents",
  "status": "active",
  "governance": {
    "sessionFaceRule": "liveEntry.sessionBody (optional, repo-prefixed path) declares the claude-session face fragment for resident-hub agents only; declaring it activates claude-session rendering (no frontmatter, target TriMetaverse/.claude/hub/<agent-id>.session.md) and binding hostEntries[claude-session] derivation; entries without sessionBody have zero behaviour on the claude-session face. True-source pointer: HOST_RENDER_REGISTRY claude-session entry + CLAUDE_SESSION_DERIVED_MARKER in TriCompany/runtime/cognition/source_publish_check.py.",
    "rule": "Every discoverable live agent must have a declared canonical source and exactly one live discovery target. Employee role agents and central agents are sourced from TriCompany and published to the current live surface; migrated module registry agents are canonical in their own module .github/agents; source-agent five-piece files and dynamic operating data must not be placed under live discovery directories.",
    "companyGovernance": "CompanyGovernanceRegistry governs publishing discipline, CHO/CAO boundary, and agent discovery eligibility.",
    "centralStrategy": "BusinessStrategy / TriMetaverseBusinessStrategyRegistry governs commercial boundaries and module priority.",
    "registryHierarchy": "Module Product/Code registries obey module BusinessStrategyRegistry, and module registries fan in to TriMetaverse BusinessStrategy/Product/Code registries; governance findings remain separate under CompanyGovernanceRegistry.",
    "lifecyclePublishRule": "New employee onboarding, responsibility changes, owner migrations, and source-agent five-piece incremental updates must follow TriCompany/docs/workflow/host-object-publish-flow.md before being treated as current live discovery updates."
  },
  "moduleRegistryMigration": {
    "status": "pilot-started",
    "canonicalRule": "Module BusinessStrategyRegistry, ProductRegistry and CodeRegistry agents should live in the corresponding module .github/agents after migration; the same logical registry must not remain discoverable in TriMetaverse/.github/agents.",
    "singleDiscoveryRule": "Before a module registry triplet becomes module-local live discovery, merge any central registry wording into the module agent files, then remove the central same-name live files and update this manifest.",
